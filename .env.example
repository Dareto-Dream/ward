# --- required ---
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://ward@127.0.0.1:5432/ward
# npm run keygen prints all four of these
WARD_SECRET=
WARD_ENCRYPTION_KEY=
WARD_SIGNING_KEY=
# Telescreen's key for /admin/v1 (set the same value as WARD_ADMIN_KEY on the telescreen)
WARD_ADMIN_KEY=
# during a signing key rotation, the old key goes here so its tokens still verify
# WARD_SIGNING_KEY_PREVIOUS=

# --- sign-in providers: each one shows up once both values are set ---
# redirect URIs: ${PUBLIC_URL}/auth/google/callback, /auth/github/callback, /auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- email (sign-up, password reset, email change) ---
# without a key, production turns email sign-up off; dev prints mail to stdout
RESEND_API_KEY=
MAIL_FROM=Ward <ward@deltavdevs.com>

# --- optional ---
SESSION_DAYS=30
# PASSWORD_BREACH_CHECK=off
